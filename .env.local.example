# Copy this file to .env.local and fill in your Supabase credentials.
# Never commit .env.local — it is already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Optional server-side API proxy override.
# Development defaults to the local server on http://localhost:2026.
# Production defaults to https://api.ydeck.app.
YDECK_API_PROXY_TARGET=http://localhost:2026

# Optional HTTPS product preview asset for the authenticated Desktop portal.
NEXT_PUBLIC_YDECK_DESKTOP_PREVIEW_URL=

# Enable only after the Desktop repository verifies registration for the exact
# ydeck://sales-operator/channels protocol route. Disabled by default.
NEXT_PUBLIC_YDECK_DESKTOP_DEEP_LINK_ENABLED=false

# Optional legacy API route support. Not needed for browser-only waitlist submits.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key-here
